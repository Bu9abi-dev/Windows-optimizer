<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentOpti" Width="1000" Height="700" MinWidth="820" MinHeight="560"
        Background="#1E1E24" Foreground="#E8E8EE" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#2A2A33"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8BFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8E8EE"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E8EE"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#4F8BFF"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="Margin" Value="0,4"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="Background" Value="#2A2A33"/><Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="bd" Background="#2A2A33" Margin="0,0,2,0" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
            <ContentPresenter ContentSource="Header" TextElement.Foreground="#E8E8EE"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="#4F8BFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="#2A2A33"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#2A2A33"/><Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="RowBackground" Value="#2A2A33"/>
      <Setter Property="AlternatingRowBackground" Value="#32323D"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1E1E24"/><Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="Padding" Value="8,6"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#E8E8EE"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#2A2A33"/><Setter Property="Foreground" Value="#E8E8EE"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#E8E8EE"/></Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="StudentOpti" FontSize="22" FontWeight="Bold" Foreground="#4F8BFF" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <CheckBox x:Name="DryRunCheck" Content="Dry run (preview only)" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <Ellipse x:Name="AdminDot" Width="10" Height="10" Fill="#6B6B76" Margin="0,0,6,0"/>
        <TextBlock x:Name="AdminText" Text="Checking..." VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock/>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="MainTabs">
      <TabItem Header="Dashboard &amp; Presets">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="Live status" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Border Background="#1E1E24" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock x:Name="RamText" Text="RAM: ..." Margin="0,2"/>
              <TextBlock x:Name="ProcText" Text="Processes: ..." Margin="0,2"/>
              <TextBlock x:Name="PlanText" Text="Power plan: ..." Margin="0,2"/>
            </StackPanel>
          </Border>
          <TextBlock Text="One-click presets (a restore point and snapshot are created first)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <WrapPanel>
            <Button x:Name="BtnPresetStudentLaptop" Content="Student Laptop Boost"/>
            <Button x:Name="BtnPresetStudyBattery" Content="Study Battery Saver"/>
            <Button x:Name="BtnPresetGamingXbox" Content="Gaming / Xbox Ready"/>
            <Button x:Name="BtnPresetFactoryDefault" Content="Restore Defaults" Background="#B04040"/>
          </WrapPanel>
          <TextBlock Text="Safety" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
          <WrapPanel>
            <Button x:Name="BtnRestorePoint" Content="Create restore point" Background="#3A3A46"/>
            <Button x:Name="BtnRestoreSnapshot" Content="Restore last snapshot" Background="#3A3A46"/>
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Debloat &amp; Privacy">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="Privacy and AI tweaks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel x:Name="DebloatPanel" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button x:Name="BtnDebloatApply" Content="Apply selected"/>
            <Button x:Name="BtnDebloatUndo" Content="Undo selected" Background="#3A3A46"/>
          </WrapPanel>
          <TextBlock Text="Apps and files" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
          <WrapPanel>
            <Button x:Name="BtnRemoveBloat" Content="Remove bloat apps"/>
            <Button x:Name="BtnRestoreApps" Content="Restore removed apps" Background="#3A3A46"/>
            <Button x:Name="BtnCleanTemp" Content="Clean temp files" Background="#3A3A46"/>
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Processes &amp; Services">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Grid.Row="0">
            <Button x:Name="BtnSvcOptimize" Content="Optimize recommended"/>
            <Button x:Name="BtnSvcRevertAll" Content="Revert all" Background="#B04040"/>
            <Button x:Name="BtnSvcRefresh" Content="Refresh" Background="#3A3A46"/>
          </WrapPanel>
          <DataGrid Grid.Row="1" x:Name="ServiceGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
              <DataGridTextColumn Header="Current" Binding="{Binding CurrentStartup}" Width="*"/>
              <DataGridTextColumn Header="Default" Binding="{Binding DefaultStartup}" Width="*"/>
              <DataGridTextColumn Header="Optimized" Binding="{Binding OptimizedStartup}" Width="*"/>
              <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="*"/>
              <DataGridTemplateColumn Header="" Width="90">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Button Content="Revert" Tag="{Binding Id}" Margin="0" Padding="8,2" Background="#3A3A46"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Process tweaks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel x:Name="ProcessTweaksPanel"/>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="BtnProcApply" Content="Apply selected"/>
              <Button x:Name="BtnProcUndo" Content="Undo selected" Background="#3A3A46"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Speed &amp; Responsiveness">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="Responsiveness and input tweaks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel x:Name="SpeedPanel" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button x:Name="BtnSpeedApply" Content="Apply selected"/>
            <Button x:Name="BtnSpeedUndo" Content="Undo selected" Background="#3A3A46"/>
            <Button x:Name="BtnRestartExplorer" Content="Restart Explorer" Background="#3A3A46"/>
          </WrapPanel>
          <TextBlock Text="Power profile" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
          <WrapPanel>
            <Button x:Name="BtnPowerStudy" Content="Study"/>
            <Button x:Name="BtnPowerPerf" Content="Performance"/>
            <Button x:Name="BtnPowerBalanced" Content="Balanced" Background="#3A3A46"/>
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Xbox &amp; Gaming">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="Component status (green = running, yellow = manual/stopped, red = disabled or not installed)" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <Border Background="#1E1E24" CornerRadius="6" Padding="14" Margin="0,0,0,16"><StackPanel>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="XboxDot_XblAuthManager" Width="16" Height="16" Fill="#6B6B76" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Xbox Live Auth Manager" VerticalAlignment="Center"/>
              <TextBlock x:Name="XboxText_XblAuthManager" Grid.Column="2" Text="..." Foreground="#A0A0AE" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="XboxDot_XblGameSave" Width="16" Height="16" Fill="#6B6B76" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Xbox Live Game Save" VerticalAlignment="Center"/>
              <TextBlock x:Name="XboxText_XblGameSave" Grid.Column="2" Text="..." Foreground="#A0A0AE" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="XboxDot_XboxNetApiSvc" Width="16" Height="16" Fill="#6B6B76" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Xbox Live Networking" VerticalAlignment="Center"/>
              <TextBlock x:Name="XboxText_XboxNetApiSvc" Grid.Column="2" Text="..." Foreground="#A0A0AE" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="XboxDot_XboxGipSvc" Width="16" Height="16" Fill="#6B6B76" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Xbox Accessory Management" VerticalAlignment="Center"/>
              <TextBlock x:Name="XboxText_XboxGipSvc" Grid.Column="2" Text="..." Foreground="#A0A0AE" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="XboxDot_GamingServices" Width="16" Height="16" Fill="#6B6B76" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Gaming Services (package)" VerticalAlignment="Center"/>
              <TextBlock x:Name="XboxText_GamingServices" Grid.Column="2" Text="..." Foreground="#A0A0AE" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="XboxDot_GameBar" Width="16" Height="16" Fill="#6B6B76" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Xbox Game Bar (package)" VerticalAlignment="Center"/>
              <TextBlock x:Name="XboxText_GameBar" Grid.Column="2" Text="..." Foreground="#A0A0AE" VerticalAlignment="Center"/></Grid>
          </StackPanel></Border>
          <TextBlock Text="Mode" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <WrapPanel>
            <Button x:Name="BtnXboxEnabled" Content="Full Enabled"/>
            <Button x:Name="BtnXboxLite" Content="Xbox Lite"/>
            <Button x:Name="BtnXboxDisabled" Content="Disabled" Background="#3A3A46"/>
            <Button x:Name="BtnXboxRefresh" Content="Refresh status" Background="#3A3A46"/>
          </WrapPanel>
          <TextBlock Text="Recovery" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
          <Button x:Name="BtnXboxEmergency" Content="Emergency Re-Enable &amp; Repair Xbox" Background="#D32F2F" FontSize="16" FontWeight="Bold" Padding="18,12" HorizontalAlignment="Left"/>
          <WrapPanel>
            <Button x:Name="BtnXboxDeep" Content="Deep Repair &amp; Reinstall Xbox Stack" Background="#B04040"/>
            <Button x:Name="BtnXboxScript" Content="Put emergency script on Desktop" Background="#3A3A46"/>
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Expander Grid.Row="2" Header="Console" IsExpanded="True" Margin="0,10,0,0">
      <StackPanel>
        <ProgressBar x:Name="BusyBar" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="#4F8BFF" Background="#2A2A33" BorderThickness="0" Margin="0,4"/>
        <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#14141A" Foreground="#C8D0E0" BorderThickness="0" Padding="6"/>
      </StackPanel>
    </Expander>
  </Grid>
</Window>
