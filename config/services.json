  "services": [
    {
      "id": "svc_diagtrack",
      "name": "Connected User Experiences and Telemetry (DiagTrack)",
      "category": "Privacy",
      "description": "Connected User Experiences and Telemetry: uploads diagnostic data.",
      "risk_level": "Safe",
      "check_script": "(Get-OptiServiceStartup -Name 'DiagTrack') -eq 'Disabled'",
      "apply_script": "Set-OptiServiceStartup -Name 'DiagTrack' -StartupType 'Disabled' -StopIfDisabled",
      "undo_script": "Set-OptiServiceStartup -Name 'DiagTrack' -StartupType 'Automatic'",
      "registry": [
        {
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\DiagTrack",
          "name": "Start"
        },
        {
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\DiagTrack",
          "name": "DelayedAutostart"
        }
      ],
      "requires_restart": "none",
      "service": "DiagTrack",
      "default_startup": "Automatic",
      "optimized_startup": "Disabled",
      "optional": false,
      "per_user": false
    },
